{
  "manifest_version": 3,
  "name": "Atlus Pay",
  "version": "0.1.0",
  "description": "Pay at any checkout with crypto. Atlus Pay detects the card form and fills it with a one-time virtual card.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["wallet-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Atlus Pay"
  }
}
