{
  "name": "atlus-pay-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Atlus Pay browser: a purpose-built shopping window with crypto checkout built in, no browser extension, no extension store review",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@walletconnect/sign-client": "^2.17.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.atluspay.desktop",
    "productName": "Atlus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "settings.js",
      "walletconnect.js",
      "home/**/*",
      "inject/**/*",
      "shell/**/*"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
