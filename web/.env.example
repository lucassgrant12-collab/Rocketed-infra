# Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings -> API -> service_role secret. Server-only -- never prefix this
# with NEXT_PUBLIC_, and never import lib/supabaseAdmin.ts from a Client
# Component.
SUPABASE_SERVICE_ROLE_KEY=

# WalletConnect Cloud project (cloud.reown.com) -- required by RainbowKit's connect modal
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Resend (resend.com) -- sends the post-payment confirmation email.
# Without a verified sending domain, Resend only delivers to the email
# address on your own Resend account -- fine for dev, not for real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
