# Supabase project -> Settings -> API -> service_role secret. Server-only,
# used by lib/supabaseAdmin.ts to record transactions and look up a wallet's
# email for the confirmation email. Never prefix this with NEXT_PUBLIC_, and
# never import supabaseAdmin.ts from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Resend (resend.com) -- sends the post-payment confirmation email.
# Without a verified sending domain, Resend only delivers to the email
# address on your own Resend account -- fine for dev, not for real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
