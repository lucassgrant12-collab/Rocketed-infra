# Personal API bearer token from your Bitrefill account settings.
# https://docs.bitrefill.com/docs/api-overview
BITREFILL_API_KEY=

# The real Bitrefill product_id for the Digital Prepaid Visa card, or
# whichever product you want to purchase. There is no fixed, guessable ID
# for this, look it up yourself first:
#   GET http://localhost:3001/api/bitrefill/search-products?q=prepaid%20visa
# then copy the "id" of the correct US Digital Prepaid Visa result here.
BITREFILL_VISA_PRODUCT_ID=

# Hard cap, in USD, on what a single invoice can be created for. This is a
# real safety limit: Bitrefill invoices created above this are rejected by
# the coordinator before ever reaching Bitrefill's API. Keep this low while
# testing.
MAX_SPEND_USD=20

PORT=3001
